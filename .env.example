# Interactive Brokers
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_READONLY=false

# Risk Management
RISK_MIN_RISK_REWARD_RATIO=2.0
RISK_ATR_PERIOD=14
RISK_ATR_MULTIPLIER_DEFAULT=2.0
RISK_MAX_LEVERAGE=3.0
RISK_MAX_POSITION_PCT=0.25

# Database (PostgreSQL)
DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/portfolio_tracker

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM / AI Agent
LLM_PROVIDER=anthropic
LLM_API_KEY=your-api-key-here
LLM_MODEL=claude-sonnet-4-20250514
